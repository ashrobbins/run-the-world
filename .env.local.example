# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase (from `supabase start` output locally, or your Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Strava API app (developers.strava.com) — Standard tier, requires an active Strava
# subscription on the developer's account per Strava's 2026 API policy.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Must match one of the "Authorization Callback Domain" values on the Strava app.
STRAVA_REDIRECT_URI=http://localhost:3000/strava/callback

# Mapbox (for the Static Images API map card)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Base URL of this app, used to build absolute redirect/callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
